# Supabase Configuration for Yatra — My Pilgrimage Planner
# Obtain these from your Supabase Dashboard: Project Settings -> API

# Public URL of your Supabase project (Safe for client-side use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Publishable / Anon API Key (Safe for client-side use; protected by RLS)
# Both NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and NEXT_PUBLIC_SUPABASE_ANON_KEY are supported.
# NEVER put the service_role key here!
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8rcDTBvUH7g4cvRtc5XGaA_s1kjJ5W6
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpzdWdwa3JhbWh3dXZveW5oYWR6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE5MTI3NjcsImV4cCI6MjEwNzQ4ODc2N30.vZqt3muPSZdB4XCNDidMwqnKt-ZYQkw9DVxnNurm69k
# Storage bucket name for ticket and booking documents (Default: trip-documents)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=trip-documents

# Optional Application Environment
NEXT_PUBLIC_APP_ENV=production
